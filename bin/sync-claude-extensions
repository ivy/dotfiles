#!/usr/bin/env bash
#
# sync-claude-extensions -- Reconcile declared Claude Code extensions
# (plugin marketplaces, plugins, MCP servers) into the user-scope install.
#
# Declared state is read from chezmoi data:
#   .claudeExtensions       committed, public  (home/.chezmoidata/claude-extensions.yaml)
#   .claudeExtensionsExtra  machine-local      ([data.claudeExtensionsExtra] in chezmoi.toml)
# and realized through the `claude` CLI, which is the single writer of the
# extraKnownMarketplaces / enabledPlugins keys and ~/.claude.json mcpServers.
#
# Idempotent and additive: only missing items are added. Items installed but not
# declared are reported, never removed, unless --prune is given. Plugins/marketplaces
# at "managed" scope (admin-pushed) are left untouched. See docs/claude-code.md.
#
# Usage: sync-claude-extensions [--check] [--prune]
#   --check   dry run: report what would change, mutate nothing
#   --prune   remove user-scope items that are installed but not declared

[[ -n "${DEBUG:-}" ]] && set -o xtrace
set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

CHECK=false
PRUNE=false

for arg in "$@"; do
  case "${arg}" in
  --check) CHECK=true ;;
  --prune) PRUNE=true ;;
  *)
    printf 'error: unknown argument: %s\n' "${arg}" >&2
    printf 'usage: sync-claude-extensions [--check] [--prune]\n' >&2
    exit 2
    ;;
  esac
done

log() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }

require_command() {
  command -v "$1" >/dev/null 2>&1
}

# Run a mutating claude command unless --check; log failures and keep going so a
# single bad item (network/auth) never aborts `chezmoi apply`.
run_claude() {
  if [[ "${CHECK}" == true ]]; then
    log "  [check] would run: claude $(redacted "$@")"
    return 0
  fi
  if ! claude "$@"; then
    warn "  warning: 'claude $(redacted "$@")' failed — continuing"
    return 1
  fi
}

# Render a command for logging with --header/--env values masked, so a resolved
# API key never reaches the terminal or a chezmoi apply log.
redacted() {
  local arg prev='' out=()
  for arg in "$@"; do
    case "${prev}" in
    --header | --env) out+=('<redacted>') ;;
    *) out+=("${arg}") ;;
    esac
    prev="${arg}"
  done
  printf '%s' "${out[*]}"
}

# Merge a declared list from base + machine-local extras under the given path
# (e.g. ".marketplaces"). Emits one compact JSON value per line. The argument is
# interpolated into the jq program, so call sites must pass a literal path suffix.
declared() {
  jq -c "((.claudeExtensions${1} // []) + (.claudeExtensionsExtra${1} // []))[]" <<<"${DATA}"
}

reconcile_marketplaces() {
  log 'marketplaces:'
  local existing declared_names name repo
  existing="$(claude plugin marketplace list --json 2>/dev/null | jq -r '.[].name' || true)"

  declared_names=''
  while IFS=$'\t' read -r name repo; do
    [[ -z "${name}" ]] && continue
    declared_names+="${name}"$'\n'
    if grep -qxF "${name}" <<<"${existing}"; then
      log "  ok: ${name}"
    else
      log "  + add ${name} (${repo})"
      run_claude plugin marketplace add "${repo}" || true
    fi
  done < <(declared '.marketplaces' | jq -r '[.name, .repo] | @tsv')

  prune_extra 'marketplace' "${existing}" "${declared_names}"
}

reconcile_plugins() {
  log 'plugins:'
  local existing_json existing_ids declared_ids id
  existing_json="$(claude plugin list --json 2>/dev/null || echo '[]')"
  # User-scope ids only are eligible for prune; managed/project are left alone.
  existing_ids="$(jq -r '.[].id' <<<"${existing_json}")"

  declared_ids=''
  while IFS= read -r id; do
    [[ -z "${id}" ]] && continue
    declared_ids+="${id}"$'\n'
    if grep -qxF "${id}" <<<"${existing_ids}"; then
      log "  ok: ${id}"
    else
      log "  + install ${id}"
      run_claude plugin install "${id}" --scope user || true
    fi
  done < <(declared '.plugins' | jq -r '.') # plugins are strings; unquote the compact JSON

  local user_ids
  user_ids="$(jq -r '.[] | select(.scope == "user") | .id' <<<"${existing_json}")"
  prune_extra 'plugin' "${user_ids}" "${declared_ids}"
}

reconcile_mcp() {
  log 'mcp servers:'
  local claude_json existing name server
  claude_json="${HOME}/.claude.json"
  existing="$(jq -r '.mcpServers // {} | keys[]' "${claude_json}" 2>/dev/null || true)"

  local declared_names=''
  while IFS= read -r server; do
    [[ -z "${server}" ]] && continue
    name="$(jq -r '.name' <<<"${server}")"
    declared_names+="${name}"$'\n'
    if grep -qxF "${name}" <<<"${existing}"; then
      log "  ok: ${name}"
    else
      log "  + add ${name}"
      mcp_add "${server}" || true
    fi
  done < <(declared '.mcpServers')

  prune_extra 'mcp' "${existing}" "${declared_names}"
}

# Expand ${op://vault/item/field} references in a declared value by reading them
# from 1Password at sync time. Keeps API keys in the vault rather than in chezmoi
# data, while still handing `claude mcp add` a literal value — the alternative,
# leaving a ${VAR} for Claude Code to expand at runtime, would put the secret in
# the environment of every subprocess an agent spawns.
resolve_secrets() {
  local value="$1" ref token secret guard=0
  # --check echoes the full command it would run; leave references unresolved so
  # a dry run never prints a secret.
  if [[ "${CHECK}" == true ]]; then
    printf '%s' "${value}"
    return 0
  fi
  while [[ "${value}" =~ \$\{(op://[^}]+)\} ]]; do
    ref="${BASH_REMATCH[1]}"
    token="\${${ref}}"
    if ! require_command op; then
      warn "  warning: op not in PATH — cannot resolve ${ref}"
      return 1
    fi
    if ! secret="$(op read "${ref}" 2>/dev/null)" || [[ -z "${secret}" ]]; then
      warn "  warning: could not read ${ref} from 1Password"
      return 1
    fi
    value="${value%%"${token}"*}${secret}${value#*"${token}"}"
    # A secret that itself looks like a reference would otherwise loop forever.
    if ((++guard > 16)); then
      warn '  warning: too many secret references'
      return 1
    fi
  done
  printf '%s' "${value}"
}

# Build and run `claude mcp add` from a server JSON object.
# http/sse: claude mcp add -s user -t <t> [-H ...] <name> <url>
# stdio:    claude mcp add -s user -t stdio [-e ...] <name> -- <command> [args...]
mcp_add() {
  local server="$1" name transport
  name="$(jq -r '.name' <<<"${server}")"
  transport="$(jq -r '.transport // "stdio"' <<<"${server}")"

  # Positionals must precede the flags: --header/--env are variadic, so a name or
  # url placed after them is consumed as another value and `claude mcp add` fails
  # with "missing required argument 'name'".
  local cmd=(mcp add "${name}")
  [[ "${transport}" != "stdio" ]] && cmd+=("$(jq -r '.url' <<<"${server}")")
  cmd+=(--scope user --transport "${transport}")

  local k v
  while IFS=$'\t' read -r k v; do
    [[ -z "${k}" ]] && continue
    v="$(resolve_secrets "${v}")" || return 1
    cmd+=(--env "${k}=${v}")
  done < <(jq -r '(.env // {}) | to_entries[] | [.key, .value] | @tsv' <<<"${server}")

  while IFS=$'\t' read -r k v; do
    [[ -z "${k}" ]] && continue
    v="$(resolve_secrets "${v}")" || return 1
    cmd+=(--header "${k}: ${v}")
  done < <(jq -r '(.headers // {}) | to_entries[] | [.key, .value] | @tsv' <<<"${server}")

  if [[ "${transport}" == "stdio" ]]; then
    cmd+=(-- "$(jq -r '.command' <<<"${server}")")
    local a
    while IFS= read -r a; do
      cmd+=("${a}")
    done < <(jq -r '(.args // [])[]' <<<"${server}")
  fi

  run_claude "${cmd[@]}"
}

# Report (and with --prune, remove) user-scope items installed but not declared.
# kind is one of: marketplace | plugin | mcp
prune_extra() {
  local kind="$1" existing="$2" declared_names="$3" item
  while IFS= read -r item; do
    [[ -z "${item}" ]] && continue
    grep -qxF "${item}" <<<"${declared_names}" && continue
    if [[ "${PRUNE}" == true ]]; then
      log "  - prune ${kind} ${item}"
      case "${kind}" in
      marketplace) run_claude plugin marketplace remove "${item}" || true ;;
      plugin) run_claude plugin uninstall "${item}" || true ;;
      mcp) run_claude mcp remove "${item}" || true ;;
      esac
    else
      log "  drift: ${kind} ${item} is installed but not declared (use --prune to remove)"
    fi
  done <<<"${existing}"
}

main() {
  if ! require_command claude; then
    warn 'claude not found in PATH — skipping extension sync'
    exit 0
  fi
  require_command jq || {
    warn 'jq not found in PATH — cannot reconcile extensions'
    exit 1
  }

  # Authenticate to GitHub for private marketplaces (machine-local extras may
  # reference one). The reconciler issues many claude calls, so export rather
  # than the inline form used for one-shot commands elsewhere.
  if [[ -z "${GITHUB_TOKEN:-}" ]] && require_command gh; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null)" || true
    [[ -n "${GITHUB_TOKEN:-}" ]] && export GITHUB_TOKEN
  fi

  DATA="$(chezmoi data --format json)"

  [[ "${CHECK}" == true ]] && log '(dry run — no changes will be made)'
  # One reconciler per type — the claude CLI surface differs per type. To add a
  # type: add a key in claude-extensions.yaml, a reconcile_* function, and a
  # prune_extra case.
  reconcile_marketplaces
  reconcile_plugins
  reconcile_mcp
  log 'done'
}

main "$@"
