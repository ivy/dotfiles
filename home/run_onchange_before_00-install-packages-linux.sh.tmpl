{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

# Runs before every other script and file: the mise tools installed next
# compile against these (cargo needs a C linker, node needs libatomic).

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Install only what is missing, so an image that already bakes these in (the
# Containerfile) needs no root, while a bare devcontainer gets what it lacks.
if command -v dnf >/dev/null 2>&1; then
    packages=(
{{ range .packages.linux.dnf -}}
        {{ . | quote }}
{{ end -}}
    )
    is_installed() { rpm -q "$1" >/dev/null 2>&1; }
elif command -v apt-get >/dev/null 2>&1; then
    packages=(
{{ range .packages.linux.apt -}}
        {{ . | quote }}
{{ end -}}
    )
    is_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
else
    echo "No supported package manager found (dnf or apt-get), skipping"
    exit 0
fi

missing=()
for pkg in "${packages[@]}"; do
    is_installed "${pkg}" || missing+=("${pkg}")
done

if [ "${#missing[@]}" -eq 0 ]; then
    echo "System packages already installed"
    exit 0
fi

# Containers commonly run as root with no sudo installed
sudo=()
if [ "$(id -u)" -ne 0 ]; then
    sudo=(sudo)
fi

echo "Installing missing packages: ${missing[*]}"
if command -v dnf >/dev/null 2>&1; then
    "${sudo[@]}" dnf install -y "${missing[@]}"
else
    # Without this, debconf falls back to asking package questions on stdin
    "${sudo[@]}" apt-get update -qq
    "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi

echo "Package installation complete"
{{ end -}}
