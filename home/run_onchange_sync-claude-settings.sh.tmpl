#!/bin/bash
# Sync Bedrock model env vars into ~/.claude/settings.json
# use_bedrock: {{ dig "claude" "use_bedrock" false . }}
# sync-script hash: {{ output "sha256sum" (joinPath .chezmoi.workingTree "bin/sync-claude-settings") | trim }}
# moshi enabled: {{ dig "moshi" "enabled" false . }}
# moshi-hook version: {{ (index (index (include "dot_config/mise/mise.lock" | fromToml).tools "http:moshi-hook") 0).version }}
# Each moshi-hook release generates new hooks; see set_moshi_hooks.

[[ -n "${DEBUG:-}" ]] && set -o xtrace
set -o errexit
set -o nounset

"{{ .chezmoi.workingTree }}/bin/sync-claude-settings"
