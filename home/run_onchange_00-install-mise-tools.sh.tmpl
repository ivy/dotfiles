#!/bin/bash

# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise lock hash: {{ include "dot_config/mise/mise.lock" | sha256sum }}

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Only run if mise is available
if ! command -v mise >/dev/null 2>&1; then
    echo "mise not found, skipping tool installation"
    exit 0
fi

# Every codebase-memory-mcp process must share one build fingerprint, enforced by
# an OS admission barrier. Installing a new version and then pruning the old one
# out from under a warm daemon leaves that daemon rejecting work, which surfaces
# later as "the MCP server stopped responding" with no obvious cause. Stopping it
# first is cheap: it is a warm-start cache holding no watches, and the next
# session respawns it.
#
# Signal the daemon rather than asking the binary to stop itself. CBM dispatches
# only cli/hook-augment/install/uninstall/update/config and treats anything else
# as "no subcommand", falling through to the stdio server -- so a stop request is
# indistinguishable from a start request, and it then blocks reading an inherited
# terminal stdin forever, hanging the apply.
#
# The daemon is spawned as `codebase-memory-mcp --cbm-daemon-internal [...]`, so
# that flag identifies it exactly and matches no session frontend. Frontends are
# left alone: they are thin per-session stdio shims that exit with their session
# and respawn a daemon from the new build on the next request.
stop_codebase_memory_daemon() {
    local pattern='cbm-daemon-internal' attempt

    pgrep -u "$(id -u)" -f "${pattern}" >/dev/null 2>&1 || return 0

    echo "Stopping codebase-memory-mcp daemon before tool changes..."
    pkill -TERM -u "$(id -u)" -f "${pattern}" >/dev/null 2>&1 || true

    for attempt in 1 2 3 4 5; do
        pgrep -u "$(id -u)" -f "${pattern}" >/dev/null 2>&1 || return 0
        sleep 1
    done

    pkill -KILL -u "$(id -u)" -f "${pattern}" >/dev/null 2>&1 || true
}

stop_codebase_memory_daemon

echo "Installing global mise tools..."

# Install all tools defined in global config
# Authenticate with GitHub via gh CLI to avoid API rate limits
{{- if lookPath "gh" }}
GITHUB_TOKEN=$(gh auth token) mise install --yes --verbose
{{- else }}
mise install --yes --verbose
{{- end }}

# qmd depends on better-sqlite3, which ships C++ source only and relies on a
# postinstall script to fetch a prebuilt binary. Our global
# NPM_CONFIG_IGNORE_SCRIPTS=1 (docs/supply-chain-security.md) blocks that, so the
# native addon never lands and every qmd invocation dies with ERR_DLOPEN_FAILED.
# Compile it from the source vendored in the tarball instead — that keeps the
# hardening intact and trusts no third-party release blob. The addon is bound to
# one Node ABI, so a node upgrade invalidates it; rebuild only when the current
# interpreter can't load it.
rebuild_qmd_sqlite_addon() {
    local qmd_root pkg_dir addon_dir node_bin

    qmd_root="$(mise where npm:@tobilu/qmd 2>/dev/null)" || return 0
    pkg_dir="${qmd_root}/lib/node_modules/@tobilu/qmd"
    [ -d "${pkg_dir}" ] || return 0

    node_bin="$(mise which node 2>/dev/null)" || return 0
    [ -x "${node_bin}" ] || return 0

    # Opening a database is the real probe: better-sqlite3 defers loading the
    # native addon until the first Database is constructed, so a bare require()
    # passes even when the addon is missing or built for another ABI.
    if (cd "${pkg_dir}" && "${node_bin}" -e "new (require('better-sqlite3'))(':memory:')") >/dev/null 2>&1; then
        return 0
    fi

    addon_dir="${pkg_dir}/node_modules/better-sqlite3"
    [ -d "${addon_dir}" ] || return 0

    echo "Rebuilding qmd's better-sqlite3 addon for Node ABI $("${node_bin}" -p 'process.versions.modules')..."
    # build-release is the package's own source build. Going through `npm
    # rebuild` instead runs the install script, which prefers a prebuilt binary
    # and only compiles when overridden by a config npm no longer recognizes.
    if ! (cd "${addon_dir}" && PATH="$(dirname "${node_bin}"):${PATH}" \
        NPM_CONFIG_IGNORE_SCRIPTS=false npm run build-release); then
        echo "warning: failed to rebuild better-sqlite3; qmd will not run until this succeeds" >&2
    fi
}

rebuild_qmd_sqlite_addon

echo "Pruning unused mise tool versions and stale caches..."
mise prune --yes
mise cache prune

echo "Global mise tools installation complete"
