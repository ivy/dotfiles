{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Only run if Homebrew is available
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found, skipping package installation"
    exit 0
fi

echo "Installing packages via brew bundle..."

# --no-upgrade installs what is missing and leaves installed packages alone.
# Upgrading here couples every apply to Homebrew succeeding across the whole
# list: casks needing admin (loopback ships an audio driver) cannot prompt for
# sudo in a non-interactive apply, and casks that update themselves drift from
# Homebrew's receipts permanently, so brew retries them forever. Either one
# aborts the apply through errexit. Upgrades belong in a deliberate
# `brew upgrade`, not in applying dotfiles.
brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

echo "Package installation complete"
{{ end -}}
