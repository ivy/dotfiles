#!/bin/sh
# Output the current system appearance: "dark" or "light".
# Always exits 0 — callers never need to guard against failure.
#
# Detection order:
#   1. BG env var (override / remote propagation)
#   2. macOS `defaults read` (local desktop)
#   3. Fallback: "light"

# BG lives in the session environment, and tmux.conf calls this before the
# first session exists; querying it then logs "no current session".
if [ -z "$BG" ] && [ -n "$TMUX" ] && [ -n "$(tmux list-sessions -F x 2>/dev/null)" ]; then
	BG="$(tmux show-environment BG 2>/dev/null | sed 's/^BG=//')"
fi

if [ -n "$BG" ]; then
	case "$BG" in
	dark) echo "dark" ;;
	*) echo "light" ;;
	esac
	exit 0
fi

case "$(uname -s)" in
Darwin)
	if defaults read -g AppleInterfaceStyle >/dev/null 2>&1; then
		echo "dark"
	else
		echo "light"
	fi
	;;
*)
	echo "light"
	;;
esac
