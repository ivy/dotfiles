#!/usr/bin/env bash
# Resumable parallel file transfer over SSH, with end-to-end verification.
#
# One SSH stream can only have a channel window's worth of data in flight per
# round trip, so on a high-latency link it leaves most of the pipe idle however
# fast the two ends are. Splitting the file into fixed pieces and pulling
# several concurrently fills that pipe: over a 38ms path this measured 4.3x a
# single stream, which is also what scp, rsync and sftp each give you.
#
# A piece is recorded as done only once its byte count matches exactly, so an
# interrupted run resumes rather than restarts. That is not a rare case: moving
# a laptop between wifi and ethernet changes its source address and drops every
# connection at once, mid-transfer.
#
# Verification hashes the pieces concurrently on both ends instead of hashing
# each file once, which keeps both sides near disk speed and names the specific
# piece that differs rather than only reporting that something does.

set -o errexit -o nounset -o pipefail

readonly DEFAULT_STREAMS=16
readonly DEFAULT_PIECE_MIB=128
readonly MIB=1048576
# Enough consecutive empty passes to outlast a router reboot or a wifi-to-
# ethernet switch, while still terminating on a genuinely dead host.
readonly MAX_STALLED_PASSES=12
readonly MAX_BACKOFF_SECONDS=120

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
readonly SELF

usage() {
	cat <<'EOF'
Usage: pget [options] [user@]host:remote-path [local-path]

Copy a large file over SSH using several concurrent streams. Resumable, and
verified piece-by-piece against the source when it lands.

Options:
  -j, --streams N     concurrent streams (default 16)
  -p, --piece MIB     piece size in MiB (default 128)
  -c, --check         verify an existing local copy, transfer nothing
  -n, --no-verify     skip verification after transfer
  -h, --help          this message

Examples:
  pget host:/srv/media/film.mkv ~/Downloads/
  pget -j 8 host:/srv/big.img /tmp/big.img
  pget --check host:/srv/big.img /tmp/big.img
EOF
}

die() {
	printf 'pget: %s\n' "$1" >&2
	exit 1
}

# Quote a path for the remote shell. Filenames routinely carry spaces, and the
# remote command is a string the login shell re-parses, not an argv vector.
shell_quote() {
	printf "'%s'" "${1//\'/\'\\\'\'}"
}

# BSD stat and GNU stat spell this differently and neither accepts the other.
if [[ "$(uname -s)" == "Darwin" ]]; then
	local_size() { stat -f %z "$1"; }
else
	local_size() { stat -c %s "$1"; }
fi

# macOS ships /usr/bin/shasum as a Perl script that runs ~5x slower than the
# same algorithm through openssl, so it is a last resort rather than a default.
if command -v openssl >/dev/null 2>&1; then
	# LibreSSL prints a bare digest, OpenSSL 3 prints "SHA2-256(stdin)= ...".
	hash_stdin() { openssl dgst -sha256 | sed 's/.*= *//'; }
elif command -v sha256sum >/dev/null 2>&1; then
	hash_stdin() { sha256sum | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
	hash_stdin() { shasum -a 256 | cut -d' ' -f1; }
else
	hash_stdin() { die "no sha256 tool found (openssl, sha256sum or shasum)"; }
fi

ssh_run() {
	ssh -o BatchMode=yes -o Compression=no -o ControlMaster=no \
		-o ServerAliveInterval=15 -o ServerAliveCountMax=8 \
		-o ConnectTimeout=20 "$@"
}

# Read one piece from the remote and splice it into the local file at the
# matching offset. Runs as a child of xargs, one process per piece.
fetch_piece() {
	local idx="$1"
	local marker="$PGET_STATE/$idx"
	[[ -f "$marker" ]] && return 0

	local offset=$((idx * PGET_PIECE_MIB * MIB))
	local want=$((PGET_PIECE_MIB * MIB))
	((offset + want > PGET_SIZE)) && want=$((PGET_SIZE - offset))

	# dd reports the byte count on stderr; a stream that dies mid-piece yields a
	# short count, which is what distinguishes a complete piece from a truncated
	# one. Writes land at a fixed offset, so short reads from the pipe stay
	# contiguous and out-of-order pieces are safe.
	local got
	got=$(ssh_run "$PGET_REMOTE" \
		"dd if=$(shell_quote "$PGET_RFILE") bs=1M skip=$((idx * PGET_PIECE_MIB)) count=$PGET_PIECE_MIB status=none" |
		dd of="$PGET_OUT" bs=1M seek=$((idx * PGET_PIECE_MIB)) conv=notrunc 2>&1 |
		awk '/bytes/ {print $1}') || true

	if [[ "$got" == "$want" ]]; then
		printf '%s' "$want" >"$marker"
		return 0
	fi
	printf 'piece %d incomplete (%s of %d bytes)\n' "$idx" "${got:-0}" "$want" >&2
	return 1
}

# Hash one piece of the local copy. Also an xargs child.
hash_piece() {
	local idx="$1"
	local digest
	digest=$(dd if="$PGET_OUT" bs=1M skip=$((idx * PGET_PIECE_MIB)) \
		count="$PGET_PIECE_MIB" status=none 2>/dev/null | hash_stdin)
	printf '%s %s\n' "$idx" "$digest"
}

count_missing() {
	local n=0 i
	for ((i = 0; i < PGET_PIECES; i++)); do
		[[ -f "$PGET_STATE/$i" ]] || n=$((n + 1))
	done
	printf '%d' "$n"
}

remote_size() {
	# The remote may be BSD or GNU; ask for both and take whichever answers.
	ssh_run "$PGET_REMOTE" \
		"stat -c %s $(shell_quote "$PGET_RFILE") 2>/dev/null || stat -f %z $(shell_quote "$PGET_RFILE")"
}

transfer() {
	local stalled=0 pass=0 remaining todo

	while :; do
		remaining=$(count_missing)
		((remaining == 0)) && break
		pass=$((pass + 1))

		printf 'pget: pass %d, %d of %d pieces remaining\n' \
			"$pass" "$remaining" "$PGET_PIECES" >&2

		todo=$(for ((i = 0; i < PGET_PIECES; i++)); do
			[[ -f "$PGET_STATE/$i" ]] || printf '%d\n' "$i"
		done)

		printf '%s\n' "$todo" |
			xargs -P "$PGET_STREAMS" -I{} "$SELF" --fetch-piece {} || true

		if (($(count_missing) >= remaining)); then
			stalled=$((stalled + 1))
			((stalled >= MAX_STALLED_PASSES)) &&
				die "no progress after $stalled passes; run again to resume"
			local backoff=$((stalled * 15))
			((backoff > MAX_BACKOFF_SECONDS)) && backoff=$MAX_BACKOFF_SECONDS
			printf 'pget: no progress, retrying in %ds\n' "$backoff" >&2
			sleep "$backoff"
		else
			stalled=0
		fi
	done
}

# Compare per-piece digests computed concurrently on both ends. Cheaper than a
# whole-file hash on each side, and it identifies which piece is wrong.
verify() {
	local tmp local_list remote_list bad
	tmp=$(mktemp -d)
	# shellcheck disable=SC2064 # expand tmp now, not at trap time
	trap "rm -rf '$tmp'" RETURN

	remote_list="$tmp/remote"
	local_list="$tmp/local"

	ssh_run "$PGET_REMOTE" \
		"bash -s $(shell_quote "$PGET_RFILE") $PGET_PIECES $PGET_PIECE_MIB $PGET_STREAMS" \
		>"$remote_list" 2>"$tmp/err" <<-'REMOTE' &
			f=$1 n=$2 m=$3 j=$4
			seq 0 $((n - 1)) | xargs -P "$j" -I@ sh -c '
				d=$(dd if="$2" bs=1M skip=$(( $1 * $3 )) count=$3 status=none 2>/dev/null |
					if command -v sha256sum >/dev/null 2>&1; then
						sha256sum | cut -d" " -f1
					else
						openssl dgst -sha256 | sed "s/.*= *//"
					fi)
				printf "%s %s\n" "$1" "$d"' _ @ "$f" "$m"
		REMOTE
	local remote_pid=$!

	seq 0 $((PGET_PIECES - 1)) |
		xargs -P "$PGET_STREAMS" -I{} "$SELF" --hash-piece {} >"$local_list"
	wait "$remote_pid" || true

	[[ -s "$remote_list" ]] || die "remote hashing failed: $(head -1 "$tmp/err")"

	sort -n "$remote_list" -o "$remote_list"
	sort -n "$local_list" -o "$local_list"

	bad=$(join -j1 "$remote_list" "$local_list" | awk '$2 != $3 {print $1}')
	if [[ -z "$bad" ]] && (($(wc -l <"$remote_list") == PGET_PIECES)); then
		printf 'pget: verified %d pieces, %d bytes\n' "$PGET_PIECES" "$PGET_SIZE"
		return 0
	fi

	# Dropping the markers makes the next run re-fetch exactly the bad pieces.
	local idx
	for idx in $bad; do rm -f "$PGET_STATE/$idx"; done
	printf 'pget: mismatched pieces: %s\n' "$(printf '%s' "$bad" | tr '\n' ' ')" >&2
	die "verification failed; run again to re-fetch the listed pieces"
}

main() {
	local streams=$DEFAULT_STREAMS piece=$DEFAULT_PIECE_MIB
	local check_only=false do_verify=true target='' dest=''

	while (($# > 0)); do
		case "$1" in
		-j | --streams)
			streams="${2:-}"
			shift 2
			;;
		-p | --piece)
			piece="${2:-}"
			shift 2
			;;
		-c | --check)
			check_only=true
			shift
			;;
		-n | --no-verify)
			do_verify=false
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		-*) die "unknown option: $1" ;;
		*)
			if [[ -z "$target" ]]; then target="$1"; else dest="$1"; fi
			shift
			;;
		esac
	done

	[[ -n "$target" ]] || {
		usage >&2
		exit 1
	}
	[[ "$target" == *:* ]] || die "target must be [user@]host:path"
	if ! [[ "$streams" =~ ^[0-9]+$ ]] || ((streams < 1)); then
		die "--streams must be a positive integer"
	fi
	if ! [[ "$piece" =~ ^[0-9]+$ ]] || ((piece < 1)); then
		die "--piece must be a positive integer"
	fi

	PGET_REMOTE="${target%%:*}"
	PGET_RFILE="${target#*:}"
	[[ -n "$PGET_RFILE" ]] || die "target must be [user@]host:path"

	[[ -z "$dest" ]] && dest="."
	[[ -d "$dest" ]] && dest="${dest%/}/$(basename "$PGET_RFILE")"
	PGET_OUT="$dest"
	PGET_STATE="$PGET_OUT.pget"
	PGET_STREAMS="$streams"
	PGET_PIECE_MIB="$piece"

	PGET_SIZE=$(remote_size) || die "cannot stat remote file: $PGET_RFILE"
	[[ "$PGET_SIZE" =~ ^[0-9]+$ ]] || die "unexpected remote size: $PGET_SIZE"
	PGET_PIECES=$(((PGET_SIZE + PGET_PIECE_MIB * MIB - 1) / (PGET_PIECE_MIB * MIB)))

	export PGET_REMOTE PGET_RFILE PGET_OUT PGET_STATE PGET_SIZE \
		PGET_PIECES PGET_PIECE_MIB PGET_STREAMS

	if [[ "$check_only" == true ]]; then
		[[ -f "$PGET_OUT" ]] || die "no local file to check: $PGET_OUT"
		local have
		have=$(local_size "$PGET_OUT")
		((have == PGET_SIZE)) || die "size differs: local $have, remote $PGET_SIZE"
		mkdir -p "$PGET_STATE"
		verify
		rmdir "$PGET_STATE" 2>/dev/null || true
		return 0
	fi

	mkdir -p "$PGET_STATE" "$(dirname "$PGET_OUT")"
	[[ -e "$PGET_OUT" ]] || : >"$PGET_OUT"

	printf 'pget: %s -> %s (%d bytes, %d pieces of %d MiB, %d streams)\n' \
		"$PGET_RFILE" "$PGET_OUT" "$PGET_SIZE" "$PGET_PIECES" "$PGET_PIECE_MIB" "$PGET_STREAMS" >&2

	transfer

	local final
	final=$(local_size "$PGET_OUT")
	((final == PGET_SIZE)) || die "size mismatch after transfer: $final of $PGET_SIZE"

	if [[ "$do_verify" == true ]]; then
		verify
	fi
	rm -rf "$PGET_STATE"
	printf 'pget: %s\n' "$PGET_OUT"
}

# xargs re-enters this script per piece; these run before argument parsing.
case "${1:-}" in
--fetch-piece)
	fetch_piece "$2"
	exit $?
	;;
--hash-piece)
	hash_piece "$2"
	exit $?
	;;
esac

main "$@"
