#!/usr/bin/env bash
# work-on [ARGS...] — start an interactive Claude Code session running /work-on
#
# Loads the skift plugin from its local checkout and hands ARGS to the skill
# verbatim. With no ARGS, picks up the next ready node.
#
# Usage:
#   work-on              # /work-on --next
#   work-on ARGS...      # /work-on ARGS...

set -o errexit -o nounset -o pipefail

readonly PLUGIN_DIR="$HOME/src/github.com/steading-ai/skift/plugin/skift"

if [[ ! -d "$PLUGIN_DIR" ]]; then
    echo "work-on: skift plugin not found at $PLUGIN_DIR" >&2
    exit 1
fi

(($#)) || set -- --next

exec claude --plugin-dir "$PLUGIN_DIR" "/work-on $*"
